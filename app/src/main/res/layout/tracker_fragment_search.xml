<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_category_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Категорія"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinner_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_category_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_date_from_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Від"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spinner_category"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_date_from"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Вибрати дату"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_date_from_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_date_to_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="До"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_date_from"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_date_to"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Вибрати дату"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_date_to_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_sort_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="По даті ↓"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btn_date_to"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_sort_amount" />

    <Button
        android:id="@+id/btn_sort_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="По сумі ↓"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btn_date_to"
        app:layout_constraintStart_toEndOf="@id/btn_sort_date"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Пошук"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btn_sort_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>